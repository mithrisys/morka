{
  "name": "morka",
  "version": "0.1.0",
  "description": "A desktop host for building and running standalone Node apps with AI agents.",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/npm-apps.test.cjs test/draft-sync.test.cjs",
    "test:electron": "electron test/live-preview-electron.test.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "dompurify": "3.4.18",
    "electron": "43.4.0",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "marked": "18.2.1",
    "marked-footnote": "1.4.0",
    "marked-gfm-heading-id": "4.1.4",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "ajv": "8.17.1"
  }
}
