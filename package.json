{
  "name": "morka",
  "productName": "Morka",
  "version": "0.3.0-beta.3",
  "author": {
    "name": "Mehrdad Farrokhmanesh",
    "url": "https://github.com/mithrisys"
  },
  "license": "MIT",
  "homepage": "https://github.com/mithrisys/morka#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mithrisys/morka.git"
  },
  "bugs": {
    "url": "https://github.com/mithrisys/morka/issues"
  },
  "private": true,
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "node scripts/build.mts",
    "check:history": "node scripts/check-history.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "start": "npm run build -- --portable && node packages/runtime/bin/morka.cjs launcher",
    "package:desktop": "npm run build && node scripts/releases/package-desktop.mjs",
    "package:mac": "npm run build && node scripts/package-mac.mts",
    "test:apps": "node --test test/npm-apps.test.cjs test/draft-sync.test.cjs test/runtime-lifecycle.test.cjs test/branding.test.cjs test/portable.test.cjs",
    "test:workflow": "node --test test/history.test.mjs test/versions.test.mjs test/desktop-release.test.mjs",
    "pretest": "npm run build",
    "test": "npm run test:apps",
    "typecheck": "tsc --noEmit",
    "test:package:mac": "node test/package-app.test.cjs",
    "test:preview": "node test/run-preview.cjs",
    "test:install:mac": "electron test/install-app-electron.test.cjs",
    "test:electron": "npm run test:preview && npm run test:install:mac"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "dompurify": "3.4.18",
    "electron": "43.4.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "marked": "18.2.1",
    "marked-footnote": "1.4.0",
    "marked-gfm-heading-id": "4.1.4",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "ajv": "8.17.1"
  },
  "description": "Build, edit, and run standalone Node.js desktop apps with local AI agents."
}
